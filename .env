# Django Core Settings
SECRET_KEY=django-insecure-change-this-in-production-to-a-secure-random-key
DEBUG=False
DJANGO_SETTINGS_MODULE=retail_management_system.settings

# Database Configuration
POSTGRES_DB=retail_management
POSTGRES_USER=thembinkosi
POSTGRES_PASSWORD=Only4u@2025@#
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Security Settings
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com,www.yourdomain.com
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# Email Configuration (for security alerts)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
SECURITY_EMAIL_FROM=noreply@yourdomain.com

# Encryption Keys (generate secure random keys)
FIELD_ENCRYPTION_KEY=your-32-byte-encryption-key-here
FILE_ENCRYPTION_KEY=your-32-byte-file-encryption-key-here

# Security Monitoring
ADMIN_EMAIL=admin@yourdomain.com
SECURITY_TEAM_EMAIL=security@yourdomain.com

# Logging
LOG_LEVEL=INFO
LOG_FILE=/var/log/retail_management/security.log

# Performance & Security
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=jpg,jpeg,png,gif,pdf,doc,docx
